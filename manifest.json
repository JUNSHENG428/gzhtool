{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "润笔 · 公众号创作者的得力助手",
  "description": "笔下生花，花下生金。从知乎/微博/小红书抓选题，AI 改写排版，一键推送公众号草稿。让普通人用文字挣到稳定的外快。",
  "version": "0.3.2",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs", "storage", "scripting", "cookies", "alarms"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://*.xiaohongshu.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.reddit.com/*",
    "https://*.zhihu.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": ["src/content-scripts/wechat-editor-helper.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "润笔 · 公众号创作者的得力助手",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "打开润笔弹窗"
    },
    "capture_current_page": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "抓取当前页并打开编辑台"
    },
    "open_workspace": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "直接打开编辑台"
    },
    "open_hot_topics": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "打开热点捕捉器"
    },
    "open_options": {
      "description": "打开设置页（需手动在 chrome://extensions/shortcuts 绑定）"
    },
    "open_agent": {
      "description": "打开 AI 选题代笔 Agent（需手动在 chrome://extensions/shortcuts 绑定）"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: http: blob:; connect-src 'self' https: http: wss: ws:;"
  }
}
