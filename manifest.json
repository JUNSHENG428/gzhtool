{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "润笔 · 公众号创作者的得力助手",
  "description": "为公众号创作者提供选题、AI 改写、杂志级排版与一键推送草稿的全流程工具。",
  "version": "0.3.3",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs", "storage", "scripting", "alarms"],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://api.weixin.qq.com/*",
    "https://docuearn.com/*",
    "https://*.docuearn.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://hot.inkgold.info/*",
    "https://newsnow.busiyi.world/*",
    "https://rsshub.app/*",
    "https://rsshub.rssforever.com/*",
    "https://rsshub.ktachibana.party/*",
    "https://api.bilibili.com/*",
    "https://www.reddit.com/*",
    "https://techcrunch.com/*",
    "https://www.theverge.com/*",
    "https://rss.arxiv.org/*",
    "https://machinelearningmastery.com/*",
    "https://towardsdatascience.com/*",
    "https://importai.substack.com/*",
    "https://www.leiphone.com/*",
    "https://hnrss.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": [
        "src/content-scripts/wechat-editor-helper.js",
        "src/content-scripts/floating-ball.bundle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docuearn.com/*", "https://*.docuearn.com/*"],
      "js": ["src/content-scripts/docuearn-auth-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "润笔 · 公众号创作者的得力助手",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "打开润笔弹窗"
    },
    "capture_current_page": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "抓取当前页并打开编辑台"
    },
    "open_workspace": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "直接打开编辑台"
    },
    "open_hot_topics": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "打开热点捕捉器"
    },
    "open_options": {
      "description": "打开设置页（需手动在 chrome://extensions/shortcuts 绑定）"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; connect-src 'self' https: wss: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*;"
  }
}
