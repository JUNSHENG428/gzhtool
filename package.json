{
  "name": "runbi",
  "private": true,
  "version": "0.3.2",
  "description": "润笔 DocuEarn · 公众号创作者的得力助手。Chrome MV3 扩展：抓选题、AI 改写、排版、一键发草稿。版本号由 manifest.json 驱动，发布前请执行 npm run version:sync。",
  "scripts": {
    "check:js": "node scripts/check-js.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:extract-chat": "node scripts/test-extract-chat.mjs",
    "test": "npm run test:smoke && npm run test:extract-chat",
    "fonts:sync": "bash scripts/sync-fonts.sh",
    "version:sync": "node scripts/version-sync.mjs",
    "build:zip": "node scripts/build-zip.mjs",
    "capture:cws": "node scripts/cws-capture.mjs",
    "dev:fixture": "node scripts/dev-fixtures.mjs",
    "check:ext": "node scripts/check-extension.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:journey": "node scripts/check-journey.mjs",
    "check:all": "npm run test:smoke && npm run check:ext && npm run check:features",
    "release:cws": "npm run test && npm run build:zip"
  },
  "keywords": [
    "chrome-extension",
    "wechat",
    "mp",
    "manifest-v3"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "playwright": "^1.59.1"
  }
}
