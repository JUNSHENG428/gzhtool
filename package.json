{
  "name": "runbi",
  "private": true,
  "version": "0.3.3",
  "description": "润笔 DocuEarn · 公众号创作者的得力助手。Chrome MV3 扩展：抓选题、AI 改写、排版、一键发草稿。版本号由 manifest.json 驱动，发布前请执行 npm run version:sync。",
  "scripts": {
    "check:js": "node scripts/check-js.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:extract-chat": "node scripts/test-extract-chat.mjs",
    "test:article-normalization": "node scripts/test-article-normalization.mjs",
    "test:scrape-article": "node scripts/test-scrape-article.mjs",
    "test:p1": "node --test scripts/test-p1-regressions.mjs",
    "test": "npm run test:smoke && npm run test:p1 && npm run test:rewrite-quality && npm run test:extract-chat && npm run test:article-normalization && npm run test:scrape-article",
    "fonts:sync": "bash scripts/sync-fonts.sh",
    "version:sync": "node scripts/version-sync.mjs",
    "build:zip": "node scripts/build-zip.mjs",
    "capture:cws": "node scripts/cws-capture.mjs",
    "dev:fixture": "node scripts/dev-fixtures.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "check:ext": "node scripts/check-extension.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:journey": "node scripts/check-journey.mjs",
    "check:all": "npm run test:smoke && npm run check:ext && npm run check:features",
    "build:floating-ball": "node scripts/build-floating-ball.mjs",
    "dev:floating-ball": "node scripts/build-floating-ball.mjs --watch",
    "check:bundle-fresh": "node scripts/check-bundle-fresh.mjs",
    "release:cws": "npm run build:floating-ball && npm run test && npm run build:zip",
    "test:rewrite-quality": "node --test scripts/test-rewrite-quality.mjs"
  },
  "keywords": [
    "chrome-extension",
    "wechat",
    "mp",
    "manifest-v3"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.2",
    "pdfjs-dist": "^5.6.205",
    "playwright": "^1.59.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
