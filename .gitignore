node_modules/

# Python venv
.venv/
__pycache__/
*.pyc

# IDE / 编辑器
.cursor/
.vscode/
.idea/

# 系统元数据
.DS_Store
**/.DS_Store
Thumbs.db

# 构建产物 / 日志
dist/
# build/ 仅匹配根目录（PyInstaller 中间产物），不要误伤 desktop/build/（打包脚本源代码）
/build/
*.log
npm-debug.log*

# 环境变量
.env
.env.local
.env.*.local

# Cloudflare Workers / Wrangler
server/.wrangler/
server/.dev.vars
.wrangler/

# Cline / Claude Memory Bank（AI 工具元数据，不入版本库）
# 用 /* 而不是 / 是为了让 file-level 例外（!reflexes.md）生效——git 不递归进 ignored 目录
memory-bank/*
memory-bank/.*
# 例外：reflexes.md 是项目级踩坑沉淀（21 反例约定 + 30 模式约定），属可被新协作者读的项目文档，入版本库
!memory-bank/reflexes.md

# Journey 测试 artifact（scripts/check-journey.mjs 每次跑覆盖，不该跟版本走）
docs/JOURNEY_REPORT.md

# Claude Code 个人偏好（项目级 .claude/launch.json 等仍可 commit）
.claude/settings.local.json

.dev.vars*
!.dev.vars.example
!.env.example
