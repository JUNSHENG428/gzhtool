{
  "name": "gzh-license-server",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare Workers 授权服务（公众号改写排版台）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute gzh-license --file=./schema.sql",
    "db:init:local": "wrangler d1 execute gzh-license --local --file=./schema.sql",
    "secret:jwt": "wrangler secret put JWT_SECRET",
    "secret:webhook": "wrangler secret put LS_WEBHOOK_SECRET",
    "secret:signing": "wrangler secret put LICENSE_SIGNING_SECRET"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
